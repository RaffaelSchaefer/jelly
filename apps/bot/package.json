{
  "name": "@joint/bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "register-commands": "tsx --env-file-if-exists=.env src/register-commands.ts",
    "check-types": "tsc --noEmit",
    "test": "DISCORD_BOT_TOKEN=test DISCORD_CLIENT_ID=test tsx --test src/*.test.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "eventsource": "^5.1.1",
    "pocketbase": "^0.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.2"
  }
}
