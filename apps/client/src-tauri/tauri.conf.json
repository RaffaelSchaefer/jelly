{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jelly",
  "version": "0.6.0",
  "identifier": "de.ucb.jelly",
  "build": {
    "beforeDevCommand": "pnpm run webpreview:dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "Jelly",
      "width": 384,
      "height": 430,
      "resizable": false,
      "maximizable": false,
      "fullscreen": false,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": true,
      "shadow": false,
      "backgroundColor": "#00000000"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1N0JDRTYyM0U3QzFDNUQKUldSZEhIdytZczU3WmJ3NmNVUldaalVUVmI0cU1qU0d3aGF0WU5FRXB3QU00OHV2ZzQ0QmlTNlQK",
      "endpoints": ["https://github.com/RaffaelSchaefer/jelly/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": { "active": true, "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"], "macOS": { "signingIdentity": "-" } }
}
