{
  "name": "lan-desk-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:rust": "node scripts/native.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "ds:bundle": "node scripts/ds-bundle.mjs",
    "check":"npm test && npm run build && npm run test:rust",
    "tauri": "node scripts/native.mjs tauri",
    "rust": "node scripts/native.mjs cargo"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
